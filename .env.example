# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Default: 9Router — a local OpenAI-compatible gateway (https://9router.com) that
# routes across 40+ providers with a built-in 3-tier fallback chain.
# On your VPS: `npm install -g 9router` then `9router start` (API + dashboard on :20128).
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=9router
LLM_MODEL=glm/glm-4.7
# Optional: force a specific model on transient errors (9Router already falls back internally)
# LLM_FALLBACK_MODEL=

# Option B: OpenRouter — comment out the 9Router block above and use these instead
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
# LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b

# Option C: LM Studio (local) — point at your local server
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here
LPAGENT_API_KEY=your_lpagent_api_key_here

# ── Telegram Notifications + Control (optional) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user IDs allowed to CONTROL the bot via chat.
# Get your ID from @userinfobot. Without this, Telegram only sends notifications.
TELEGRAM_ALLOWED_USER_IDS=

# ── Discord signal listener (optional, ADVANCED) ──────────────────────────────
# Inbound signals only. Runs as a separate process (discord-listener/).
# WARNING: uses a Discord *selfbot* (your personal account token) which violates
# Discord's Terms of Service and can get your account banned. Use at your own risk.
DISCORD_USER_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
# DISCORD_MIN_FEES_SOL=5

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=info
