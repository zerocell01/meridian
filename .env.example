# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Default: 9Router — a local OpenAI-compatible gateway (https://9router.com) that
# routes across many providers with a built-in fallback chain.
# On your VPS: `npm install -g 9router` then run it inside tmux:
#   tmux new-session -d -s ninerouter '9router start'
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=9router
# Use any model id available in your 9Router dashboard. `kr/claude-sonnet-4.5` is
# a Kiro-provided Claude model that works well for tool-calling.
LLM_MODEL=kr/claude-sonnet-4.5

# Output language for all agent prose (reports, reasoning, alerts, chat replies).
# Default English. Set to "Bahasa Indonesia" to localize Telegram notifications.
# LLM_LANGUAGE=Bahasa Indonesia

# Option B: OpenRouter — comment out the 9Router block above and use these instead
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-your_openrouter_key_here
# LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b

# Option C: LM Studio (local) — point at your local server
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here
LPAGENT_API_KEY=your_lpagent_api_key_here

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=info
